@model MessengerApp1.Models.RegisterViewModel
@{
    Layout = "_Layout";
}

<div class="flex items-center justify-center py-20 font-mono">
    <div class="w-full max-w-md border border-white/10 bg-[#050505] p-10 rounded-xl shadow-2xl">
        <div class="mb-10 space-y-2">
            <h2 class="text-xl font-bold tracking-[0.3em] uppercase text-white">Initialize_Node</h2>
            <p class="text-[9px] text-green-500 uppercase tracking-widest">Protocol: Anonymous_P2P</p>
        </div>

        <form asp-action="Register" method="post" class="space-y-6">
            <div asp-validation-summary="All" class="text-red-500 text-[10px] mb-4"></div>

            <div class="space-y-1">
                <label class="text-[9px] text-zinc-500 uppercase ml-1">@("@")Unique_Handle</label>
                <input name="UserName" class="auth-input" placeholder="shadow_walker" required />
            </div>

            <div class="space-y-1">
                <label class="text-[9px] text-zinc-500 uppercase ml-1">Email_Address</label>
                <input asp-for="Email" class="auth-input" placeholder="node@enuxion.net" required />
            </div>

            <div class="grid grid-cols-2 gap-4">
                <div class="space-y-1">
                    <label class="text-[9px] text-zinc-500 uppercase ml-1">Access_Key</label>
                    <input asp-for="Password" type="password" class="auth-input" placeholder="••••••••" required />
                </div>
                <div class="space-y-1">
                    <label class="text-[9px] text-zinc-500 uppercase ml-1">Confirm_Key</label>
                    <input asp-for="ConfirmPassword" type="password" class="auth-input" placeholder="••••••••" required />
                </div>
            </div>

            <button type="submit" class="w-full py-4 bg-white text-black text-xs font-black uppercase tracking-widest hover:bg-zinc-200 transition-all active:scale-95 shadow-[0_0_40px_rgba(255,255,255,0.05)]">
                Initialize_Registration
            </button>
        </form>
    </div>
</div>

<style>
    .auth-input {
        width: 100%;
        background: #0a0a0a !important;
        border: 1px solid rgba(255, 255, 255, 0.1) !important;
        padding: 14px;
        font-size: 13px;
        color: white !important;
        outline: none;
    }

        .auth-input:focus {
            border-color: white !important;
        }
</style>