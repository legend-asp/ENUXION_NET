@model MessengerApp1.Models.ProfileViewModel

<div class="max-w-lg mx-auto py-12 font-mono">
    <div class="bg-zinc-950 border border-white/5 p-10 rounded-sm shadow-2xl">
        <h2 class="text-lg font-bold tracking-[0.4em] uppercase text-white mb-10 text-center">Node_Settings</h2>

        <form asp-action="Settings" asp-controller="Profile" method="post" enctype="multipart/form-data" class="space-y-6">
            <div class="flex justify-center mb-8">
                <div class="relative group">
                    <img src="@(string.IsNullOrEmpty(Model.PhotoPath) ? "/images/default-avatar.png" : Model.PhotoPath)"
                         alt="Avatar"
                         class="w-24 h-24 border border-white/10 object-cover grayscale group-hover:grayscale-0 transition-all" />
                    <div class="absolute inset-0 bg-black/60 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity">
                        <span class="text-[8px] text-white">UPDATE_IMG</span>
                    </div>
                </div>
            </div>

            <div class="space-y-4">
                <div class="space-y-1">
                    <label class="text-[9px] text-zinc-600 uppercase tracking-widest">Public_Status</label>
                    <input asp-for="Status" placeholder="ONLINE / BUSY / ENCRYPTING" class="terminal-input" />
                </div>

                <div class="space-y-1">
                    <label class="text-[9px] text-zinc-600 uppercase tracking-widest">System_Bio</label>
                    <textarea asp-for="About" rows="4" placeholder="Brief info..." class="terminal-input resize-none"></textarea>
                </div>

                <div class="space-y-1 pt-2">
                    <label class="text-[9px] text-zinc-600 uppercase tracking-widest block mb-2">Access_Icon (File)</label>
                    <input asp-for="Photo" type="file" class="text-[10px] text-zinc-500 file:bg-zinc-800 file:text-zinc-300 file:border-0 file:px-4 file:py-2 file:mr-4 hover:file:bg-zinc-700" />
                </div>
            </div>

            <!-- СЕКЦИЯ ВЫБОРА ТЕМЫ ОФОРМЛЕНИЯ -->
            <div class="mt-8 pt-6 border-t border-white/10">
                <div class="flex items-center justify-between mb-4">
                    <div>
                        <h3 class="text-xs uppercase font-black tracking-widest text-white mono">// INTERFACE_PALETTE</h3>
                        <p class="text-[10px] text-zinc-500 mono mt-0.5">Выберите неоновую световую схему для терминала мессенджера</p>
                    </div>
                    <span id="currentThemeLabel" class="text-[9px] mono uppercase px-2 py-0.5 rounded border border-white/10 text-zinc-400">BLUE_CORE</span>
                </div>

                <!-- Сетка карточек с темами -->
                <div class="grid grid-cols-2 sm:grid-cols-5 gap-3" id="themePickerContainer">
                    <!-- 1. Cyber Blue -->
                    <button type="button" onclick="setAppTheme('blue', 'CYBER_BLUE')"
                            data-theme-card="blue"
                            class="flex flex-col items-center gap-2.5 p-3 rounded-lg border border-white/10 bg-white/[0.02] hover:bg-white/[0.05] transition-all text-left">
                        <span class="w-5 h-5 rounded-full bg-[#3b82f6] shadow-[0_0_10px_#3b82f6]"></span>
                        <span class="text-[9px] mono font-bold text-zinc-300 uppercase tracking-wider">Cyber Blue</span>
                    </button>

                    <!-- 2. Matrix Green -->
                    <button type="button" onclick="setAppTheme('matrix', 'MATRIX_GREEN')"
                            data-theme-card="matrix"
                            class="flex flex-col items-center gap-2.5 p-3 rounded-lg border border-white/10 bg-white/[0.02] hover:bg-white/[0.05] transition-all text-left">
                        <span class="w-5 h-5 rounded-full bg-[#10b981] shadow-[0_0_10px_#10b981]"></span>
                        <span class="text-[9px] mono font-bold text-zinc-300 uppercase tracking-wider">Matrix</span>
                    </button>

                    <!-- 3. Amber 2077 -->
                    <button type="button" onclick="setAppTheme('amber', 'AMBER_2077')"
                            data-theme-card="amber"
                            class="flex flex-col items-center gap-2.5 p-3 rounded-lg border border-white/10 bg-white/[0.02] hover:bg-white/[0.05] transition-all text-left">
                        <span class="w-5 h-5 rounded-full bg-[#f59e0b] shadow-[0_0_10px_#f59e0b]"></span>
                        <span class="text-[9px] mono font-bold text-zinc-300 uppercase tracking-wider">Amber 2077</span>
                    </button>

                    <!-- 4. Synth Violet -->
                    <button type="button" onclick="setAppTheme('violet', 'SYNTH_VIOLET')"
                            data-theme-card="violet"
                            class="flex flex-col items-center gap-2.5 p-3 rounded-lg border border-white/10 bg-white/[0.02] hover:bg-white/[0.05] transition-all text-left">
                        <span class="w-5 h-5 rounded-full bg-[#a855f7] shadow-[0_0_10px_#a855f7]"></span>
                        <span class="text-[9px] mono font-bold text-zinc-300 uppercase tracking-wider">Synthwave</span>
                    </button>

                    <!-- 5. Crimson Syndicate -->
                    <button type="button" onclick="setAppTheme('crimson', 'CRIMSON_RED')"
                            data-theme-card="crimson"
                            class="flex flex-col items-center gap-2.5 p-3 rounded-lg border border-white/10 bg-white/[0.02] hover:bg-white/[0.05] transition-all text-left">
                        <span class="w-5 h-5 rounded-full bg-[#ef4444] shadow-[0_0_10px_#ef4444]"></span>
                        <span class="text-[9px] mono font-bold text-zinc-300 uppercase tracking-wider">Crimson</span>
                    </button>
                </div>
            </div>

            <button type="submit" class="w-full py-4 bg-white text-black text-[10px] font-black uppercase tracking-[0.2em] hover:invert transition-all">
                Save_Configuration
            </button>
        </form>
    </div>
</div>

<style>
    .terminal-input {
        width: 100%;
        background: #000;
        border: 1px solid rgba(255,255,255,0.05);
        padding: 12px;
        color: white;
        font-size: 12px;
        outline: none;
    }

        .terminal-input:focus {
            border-color: rgba(255,255,255,0.3);
        }
</style>

@section Scripts {
    <script>
        function setAppTheme(themeName, label) {
            // 1. Мгновенно применяем тему к <html>
            document.documentElement.setAttribute('data-theme', themeName);

            // 2. Сохраняем в localStorage
            localStorage.setItem('enuxion_theme', themeName);

            // 3. Обновляем плашку с названием темы
            const labelEl = document.getElementById('currentThemeLabel');
            if (labelEl) labelEl.textContent = label || themeName.toUpperCase();

            // 4. Подсвечиваем активную карточку
            document.querySelectorAll('[data-theme-card]').forEach(card => {
                if (card.getAttribute('data-theme-card') === themeName) {
                    card.classList.add('border-white', 'bg-white/10');
                    card.classList.remove('border-white/10');
                } else {
                    card.classList.remove('border-white', 'bg-white/10');
                    card.classList.add('border-white/10');
                }
            });
        }

        // Подсвечиваем текущую тему при загрузке страницы
        document.addEventListener('DOMContentLoaded', () => {
            const current = localStorage.getItem('enuxion_theme') || 'blue';
            setAppTheme(current);
        });
    </script>
}