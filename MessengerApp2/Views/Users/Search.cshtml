@model IEnumerable<MessengerApp1.Models.ApplicationUser>

<div class="max-w-4xl mx-auto py-10 font-mono">
    <div class="border border-white/10 bg-zinc-950 p-6 shadow-2xl mb-10">
        <h3 class="text-xs font-bold tracking-[0.3em] uppercase text-zinc-400 mb-6 flex items-center gap-2">
            <span class="w-2 h-2 bg-blue-500 rounded-full animate-pulse"></span>
            Global_Node_Search
        </h3>

        <form method="get" asp-action="Index" class="flex gap-4">
            <div class="flex-1 relative">
                <input type="text" name="searchTerm" value="@ViewBag.SearchTerm"
                       placeholder="SCAN_BY_USERNAME_OR_ID..."
                       class="w-full bg-black border border-white/10 p-3 text-white text-xs outline-none focus:border-blue-500 transition-all" />
            </div>
            <button type="submit" class="bg-white text-black px-8 text-[10px] font-bold uppercase hover:bg-zinc-200 transition-all">
                Execute_Scan
            </button>
        </form>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="text-center py-20 border border-dashed border-white/5 bg-zinc-950/50">
            <p class="text-[10px] text-zinc-600 uppercase tracking-widest">No active nodes found matching the criteria.</p>
            <a asp-action="Index" class="text-[10px] text-blue-500 hover:underline mt-4 inline-block">[ RESET_BUFFERS ]</a>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            @foreach (var user in Model)
            {
                <div class="group bg-zinc-950 border border-white/5 hover:border-blue-500/50 transition-all duration-300">
                    <div class="p-5 flex items-center gap-5">
                        <div class="relative">
                            <img src="@(string.IsNullOrEmpty(user.PhotoPath) ? "/img/default-avatar.png" : user.PhotoPath)"
                                 class="w-14 h-14 grayscale group-hover:grayscale-0 border border-white/10 transition-all" />
                            <div class="absolute -bottom-1 -right-1 w-3 h-3 bg-green-500 border-2 border-zinc-950 rounded-full"></div>
                        </div>

                        <div class="flex-1 min-w-0">
                            <h4 class="text-sm font-bold text-white truncate">
                                @("@")@user.UserName
                            </h4>
                            <div class="flex items-center gap-3 mt-1">
                                <span class="text-[9px] text-zinc-500 uppercase">Status: @(user.Status ?? "OPERATOR")</span>
                                <span class="text-[9px] text-blue-500 font-bold">@user.Balance.ToString("N2") ENU</span>
                            </div>
                        </div>
                    </div>

                    <div class="border-t border-white/5 bg-white/[0.02]">
                        <a asp-controller="Messages" asp-action="Chat" asp-route-id="@user.Id"
                           class="block w-full py-3 text-center text-[10px] font-bold text-zinc-400 group-hover:text-white group-hover:bg-blue-500/10 transition-all uppercase tracking-widest">
                            Access_Profile_Data
                        </a>
                    </div>
                </div>
            }
        </div>
    }
</div>