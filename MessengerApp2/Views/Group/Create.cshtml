@{
    ViewData["Title"] = "INITIALIZE_CLUSTER";
}

<div class="max-w-md mx-auto py-12 font-mono text-white">
    <div class="bg-zinc-950 border border-white/10 p-8 rounded-xl shadow-2xl backdrop-blur-md">
        <div class="flex items-center gap-3 mb-6">
            <div class="w-8 h-8 rounded-lg bg-white/[0.05] border border-white/10 flex items-center justify-center">
                <i class="bi bi-plus-square-fill text-sm" style="color: var(--accent, #3b82f6);"></i>
            </div>
            <div>
                <h2 class="text-sm font-black tracking-widest uppercase">// INITIALIZE_NEW_CLUSTER</h2>
                <p class="text-[9px] text-zinc-500 uppercase tracking-widest">Broadcast Channel Spec</p>
            </div>
        </div>

        <form asp-action="Create" method="post" class="space-y-6">
            @Html.AntiForgeryToken()

            <div class="space-y-2">
                <label class="text-[9px] text-zinc-500 uppercase tracking-widest block">Cluster_Identifier (Name)</label>
                <input type="text" name="groupName" required autofocus
                       placeholder="e.g. CYBER_SYNDICATE_01"
                       class="w-full bg-black border border-white/10 px-4 py-3 text-xs text-white uppercase tracking-wider outline-none focus:border-white/40 rounded transition-all" />
            </div>

            <div class="p-3 bg-white/[0.02] border border-white/5 rounded text-[9px] text-zinc-500 leading-relaxed">
                <span class="text-zinc-400 font-bold block mb-1">SECURITY_NOTE:</span>
                Канал будет автоматически зашифрован. Вы станете его оператором и сможете приглашать других участников по ссылке или через поиск.
            </div>

            <div class="flex gap-3 pt-2">
                <a asp-action="Index"
                   class="flex-1 py-3 text-center border border-white/10 hover:bg-white/5 text-[10px] font-bold uppercase tracking-widest text-zinc-400 transition-all rounded no-underline">
                    ABORT
                </a>
                <button type="submit"
                        style="background-color: var(--accent, #3b82f6); color: #000;"
                        class="flex-1 py-3 text-[10px] font-black uppercase tracking-widest hover:brightness-110 transition-all rounded shadow-md">
                    ESTABLISH
                </button>
            </div>
        </form>
    </div>
</div>