@model MessengerApp1.Controllers.GroupIndexViewModel

@{
    ViewData["Title"] = "COMMUNICATIONS_HUB";
}

<div class="max-w-6xl mx-auto py-8 font-mono text-white">
    <!-- ВЕРХНЯЯ ИНФО-ПАНЕЛЬ СЕТИ -->
    <div class="flex flex-col md:flex-row justify-between items-start md:items-end mb-8 border-b border-white/10 pb-6 gap-4">
        <div>
            <div class="flex items-center gap-3">
                <h2 class="text-2xl font-black tracking-[0.3em] uppercase">COMMUNICATIONS_HUB</h2>
                <span class="text-[9px] px-2 py-0.5 rounded border border-white/10 bg-white/[0.04] text-zinc-400">v3.8_NET</span>
            </div>
            <p class="text-[10px] text-zinc-500 uppercase mt-1 tracking-widest flex items-center gap-2">
                <span class="inline-block w-2 h-2 rounded-full animate-pulse" style="background-color: var(--accent, #3b82f6);"></span>
                Network: Mainnet • Clusters: @Model.UserGroups.Count • P2P Nodes: @Model.DirectNodes.Count
            </p>
        </div>

        <!-- Кнопки действий -->
        <div class="flex items-center gap-3">
            <a asp-action="Create"
               style="background-color: var(--accent, #3b82f6); color: #000;"
               class="text-[10px] px-5 py-2.5 font-black uppercase tracking-widest hover:brightness-110 transition-all flex items-center gap-2 shadow-sm rounded-sm no-underline">
                <i class="bi bi-plus-circle-fill"></i>
                <span>INITIALIZE_CLUSTER</span>
            </a>
            <a asp-controller="Search" asp-action="Index"
               class="text-[10px] border border-white/20 px-5 py-2.5 hover:bg-white hover:text-black transition-all uppercase tracking-widest font-bold no-underline">
                [ GLOBAL_SCANNER ]
            </a>
        </div>
    </div>

    <!-- ТАБЫ (ПЕРЕКЛЮЧАТЕЛЬ СТИЛЯ ДИСКОРД/ТЕЛЕГРАМ) -->
    <div class="flex gap-4 border-b border-white/10 mb-8">
        <button type="button" onclick="switchHubTab('clusters')" id="tabBtnClusters"
                class="pb-3 text-xs uppercase font-bold tracking-widest transition-all border-b-2 border-white text-white flex items-center gap-2">
            <i class="bi bi-diagram-3-fill text-xs" style="color: var(--accent, #3b82f6);"></i>
            <span>CLUSTER_GROUPS (@Model.UserGroups.Count)</span>
        </button>
        <button type="button" onclick="switchHubTab('direct')" id="tabBtnDirect"
                class="pb-3 text-xs uppercase font-bold tracking-widest transition-all border-b-2 border-transparent text-zinc-500 hover:text-zinc-300 flex items-center gap-2">
            <i class="bi bi-person-fill text-xs"></i>
            <span>P2P_DIRECT_NODES (@Model.DirectNodes.Count)</span>
        </button>
    </div>

    <!-- СЕКЦИЯ 1: ГРУППОВЫЕ КЛАСТЕРЫ (DISCORD-STYLE) -->
    <div id="sectionClusters" class="space-y-4">
        @if (!Model.UserGroups.Any())
        {
            <div class="py-20 text-center border border-dashed border-white/10 bg-zinc-950/40 rounded-xl">
                <div class="w-12 h-12 mx-auto mb-4 rounded-full bg-white/[0.03] border border-white/10 flex items-center justify-center">
                    <i class="bi bi-diagram-3 text-xl text-zinc-600"></i>
                </div>
                <p class="text-xs text-zinc-400 uppercase tracking-widest mb-1">No group clusters linked yet</p>
                <p class="text-[10px] text-zinc-600 tracking-wider mb-6">Создайте закрытую группу для команды или проекта</p>
                <a asp-action="Create"
                   style="border-color: var(--accent, #3b82f6); color: var(--accent, #3b82f6);"
                   class="inline-block text-[10px] border px-6 py-2.5 uppercase font-bold tracking-widest hover:brightness-125 transition-all no-underline">
                    + CREATE_FIRST_CLUSTER
                </a>
            </div>
        }
        else
        {
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                @foreach (var group in Model.UserGroups)
                {
                    var lastMsg = group.Messages?.OrderByDescending(m => m.Timestamp).FirstOrDefault();
                    <a asp-action="Chat" asp-route-id="@group.Id"
                       class="group p-5 bg-white/[0.02] border border-white/10 hover:border-white/30 rounded-xl transition-all duration-300 flex items-center justify-between no-underline">
                        <div class="flex items-center gap-4">
                            <!-- Иконка сервера -->
                            <div class="w-12 h-12 rounded-lg bg-zinc-900 border border-white/10 flex items-center justify-center text-lg font-black text-white group-hover:scale-105 transition-transform"
                                 style="border-color: rgba(var(--accent-rgb, 59, 130, 246), 0.3);">
                                @group.Name.Substring(0, Math.Min(2, group.Name.Length)).ToUpper()
                            </div>
                            <div>
                                <div class="flex items-center gap-2">
                                    <h3 class="text-sm font-black text-white uppercase tracking-wider group-hover:text-zinc-200">@group.Name</h3>
                                    <span class="text-[8px] px-1.5 py-0.5 rounded bg-white/5 border border-white/10 text-zinc-400">CLUSTER</span>
                                </div>
                                <p class="text-[10px] text-zinc-500 mt-1 truncate max-w-[240px]">
                                    @(lastMsg != null ? $"{lastMsg.Text}" : "Secure channel initialized")
                                </p>
                            </div>
                        </div>

                        <div class="flex items-center gap-3">
                            <span class="text-[9px] mono text-zinc-600 group-hover:text-white transition-colors">
                                ENTER_UPLINK →
                            </span>
                        </div>
                    </a>
                }
            </div>
        }
    </div>

    <!-- СЕКЦИЯ 2: ЛИЧНЫЕ ДИАЛОГИ (P2P NODES) -->
    <div id="sectionDirect" class="hidden space-y-3">
        @if (!Model.DirectNodes.Any())
        {
            <div class="py-20 text-center border border-dashed border-white/10 bg-zinc-950/40 rounded-xl">
                <p class="text-[11px] text-zinc-500 uppercase tracking-widest mb-4">No active P2P nodes found</p>
                <a asp-controller="Search" asp-action="Index"
                   class="text-[10px] text-blue-400 hover:text-white uppercase transition-colors no-underline">
                    [ Run_Global_Node_Scanner ]
                </a>
            </div>
        }
        else
        {
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                @foreach (var node in Model.DirectNodes)
                {
                    <div class="p-4 bg-white/[0.02] border border-white/10 hover:border-white/30 rounded-xl transition-all duration-300 flex items-center justify-between">
                        <div class="flex items-center gap-4">
                            <div class="relative w-11 h-11 bg-zinc-900 border border-white/10 rounded-full overflow-hidden">
                                <img src="@(string.IsNullOrEmpty(node.PhotoPath) ? "/images/default-avatar.png" : node.PhotoPath)"
                                     alt="Avatar"
                                     class="w-full h-full object-cover grayscale hover:grayscale-0 transition-all" />
                                <span class="absolute bottom-0 right-0 w-2.5 h-2.5 rounded-full ring-2 ring-black"
                                      style="background-color: var(--accent, #3b82f6);"></span>
                            </div>

                            <div>
                                <span class="text-xs font-bold text-white uppercase tracking-wider block">@("@")@node.UserName</span>
                                <span class="text-[9px] text-zinc-500 uppercase">@(node.Status ?? "ONLINE")</span>
                            </div>
                        </div>

                        <div class="flex items-center gap-2">
                            <a asp-controller="Profile" asp-action="View" asp-route-id="@node.Id"
                               class="text-[9px] px-2.5 py-1.5 border border-white/10 hover:border-white/30 text-zinc-400 hover:text-white rounded transition-colors no-underline">
                                INFO
                            </a>
                            <a asp-controller="Messages" asp-action="Chat" asp-route-id="@node.Id"
                               style="background-color: var(--accent, #3b82f6); color: #000;"
                               class="text-[9px] px-3 py-1.5 font-bold uppercase rounded hover:brightness-110 transition-all no-underline">
                                CHAT
                            </a>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        function switchHubTab(tab) {
            const secClusters = document.getElementById('sectionClusters');
            const secDirect = document.getElementById('sectionDirect');
            const btnClusters = document.getElementById('tabBtnClusters');
            const btnDirect = document.getElementById('tabBtnDirect');

            if (tab === 'clusters') {
                secClusters.classList.remove('hidden');
                secDirect.classList.add('hidden');
                btnClusters.classList.add('border-white', 'text-white');
                btnClusters.classList.remove('border-transparent', 'text-zinc-500');
                btnDirect.classList.remove('border-white', 'text-white');
                btnDirect.classList.add('border-transparent', 'text-zinc-500');
            } else {
                secDirect.classList.remove('hidden');
                secClusters.classList.add('hidden');
                btnDirect.classList.add('border-white', 'text-white');
                btnDirect.classList.remove('border-transparent', 'text-zinc-500');
                btnClusters.classList.remove('border-white', 'text-white');
                btnClusters.classList.add('border-transparent', 'text-zinc-500');
            }
        }
    </script>
}