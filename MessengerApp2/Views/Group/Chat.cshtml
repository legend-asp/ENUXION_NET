@model MessengerApp1.Models.Group
@{
    var currentUserId = ViewBag.CurrentUserId as string;
    int membersCount = ViewBag.MembersCount ?? 1;
}

<div class="max-w-4xl mx-auto py-6 font-mono text-white">
    <div class="border border-white/10 bg-black/50 backdrop-blur-md rounded-2xl overflow-hidden shadow-2xl">
        <!-- ШАПКА ЧАТА ГРУППЫ -->
        <div class="p-4 border-b border-white/10 bg-white/[0.02] flex justify-between items-center">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-lg bg-zinc-900 border border-white/10 flex items-center justify-center font-black text-sm"
                     style="color: var(--accent, #3b82f6);">
                    #
                </div>
                <div>
                    <h2 class="text-xs font-black tracking-widest uppercase text-white">@Model.Name</h2>
                    <span class="text-[8px] text-zinc-500 uppercase tracking-widest block">
                        CLUSTER_NODES: @membersCount ONLINE
                    </span>
                </div>
            </div>

            <div class="flex items-center gap-3">
                <a asp-action="Index"
                   class="text-[9px] px-3 py-1.5 border border-white/10 hover:border-white/30 text-zinc-400 hover:text-white rounded uppercase tracking-wider transition-all no-underline">
                    [ ESCAPE_CLUSTER ]
                </a>
            </div>
        </div>

        <!-- ЛЕНТА СООБЩЕНИЙ -->
        <div id="chatWindow" class="h-[520px] overflow-y-auto p-6 space-y-4 bg-black/20">
            @foreach (var msg in Model.Messages.OrderBy(m => m.Timestamp))
            {
                var isMine = msg.SenderId == currentUserId;
                string senderName = msg.Sender?.UserName ?? ("ID_" + (msg.SenderId.Length > 6 ? msg.SenderId.Substring(0, 6) : msg.SenderId));

                <div class="flex flex-col @(isMine ? "items-end" : "items-start")">
                    <span class="text-[8px] text-zinc-500 mb-1 tracking-wider">@("@")@senderName.ToUpper()</span>

                    @if (msg.Text.Contains("/send"))
                    {
                        <div class="bg-zinc-900 border border-white/20 p-4 rounded-xl min-w-[200px] shadow-lg">
                            <div class="flex justify-between items-start mb-2">
                                <span class="text-[8px] font-black uppercase text-zinc-400">Transfer</span>
                                <i class="bi bi-patch-check-fill text-xs" style="color: var(--accent, #3b82f6);"></i>
                            </div>
                            <div class="text-xl font-black text-white">@msg.Text.Replace("/send", "").Trim() <span class="text-xs" style="color: var(--accent, #3b82f6);">ENU</span></div>
                            <div class="text-[7px] text-zinc-500 uppercase mt-1">Network: Enuxion_Mainnet</div>
                        </div>
                    }
                    else
                    {
                        <div class="max-w-[75%] p-3 rounded-2xl text-sm @(isMine ? "text-white" : "bg-zinc-900 text-zinc-300 border border-white/10")"
                             style="@(isMine ? "background-color: var(--accent, #2563eb);" : "")">
                            @msg.Text
                        </div>
                    }
                    <span class="text-[8px] text-zinc-600 mt-1">@msg.Timestamp.ToString("HH:mm")</span>
                </div>
            }
        </div>

        <!-- ФОРМА ОТПРАВКИ -->
        <div class="p-4 bg-zinc-950 border-t border-white/10">
            <form asp-action="SendMessage" method="post" class="flex gap-2">
                @Html.AntiForgeryToken()
                <input type="hidden" name="groupId" value="@Model.Id" />
                <input type="text" name="text" placeholder="Broadcast to cluster..." autocomplete="off" required
                       class="flex-1 bg-white/[0.04] border border-white/10 px-5 py-3 rounded-xl text-xs text-white outline-none focus:border-white/30 transition-all" />
                <button type="submit"
                        style="background-color: var(--accent, #3b82f6); color: #000;"
                        class="px-6 py-3 rounded-xl text-[10px] font-black uppercase tracking-widest hover:brightness-110 transition-all">
                    SEND
                </button>
            </form>
        </div>
    </div>
</div>

<script>
    var chat = document.getElementById("chatWindow");
    chat.scrollTop = chat.scrollHeight;
</script>